{
  "name": "beystadium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "data:build": "node scripts/build-data-index.mjs --build",
    "data:check": "node scripts/build-data-index.mjs --check",
    "audit:app": "node scripts/audit-app.mjs",
    "lint:js": "eslint scripts tests \"src/**/*.js\" playwright.config.mjs eslint.config.js",
    "test:bey-relations": "node --test tests/bey-relations.test.mjs tests/bey-badge-render.test.mjs tests/metal-fight-characters.test.mjs tests/character-usage.test.mjs tests/metal-media-beys.test.mjs tests/metal-character-upgrades.test.mjs tests/metal-new-characters.test.mjs",
    "test:search": "node --test tests/search-core.test.mjs",
    "test:routes": "node --test tests/route-parser.test.mjs",
    "test:ids": "node --test tests/x-bey-id.test.mjs",
    "test:address-ids": "node --test tests/address-id.test.mjs",
    "test:product-ids": "node --test tests/product-id.test.mjs",
    "test:anime-episodes": "node --test tests/anime-episodes.test.mjs",
    "test:burst-random-boosters": "node --test tests/burst-random-boosters.test.mjs",
    "test:burst-random-layers": "node --test tests/burst-random-layers.test.mjs",
    "test:burst-remake-sets": "node --test tests/burst-remake-sets.test.mjs",
    "test:burst-images": "node scripts/validate-burst-bey-images.mjs",
    "test:x-tool-products": "node --test tests/x-tool-products.test.mjs",
    "test:x-part-products": "node --test tests/x-part-products.test.mjs",
    "test:x-set-products": "node --test tests/x-set-products.test.mjs",
    "test:x-random-boosters": "node --test tests/x-random-boosters.test.mjs",
    "test:x-jp-part-details": "node --test tests/x-jp-part-details.test.mjs",
    "test:x-kr-bey-details": "node --test tests/x-kr-bey-details.test.mjs",
    "x-images:review": "node scripts/record-x-image-review.mjs",
    "x-images:review:report": "node scripts/build-x-image-review-report.mjs",
    "x-images:alpha-review": "python scripts/record-x-image-alpha-review.py",
    "x-images:map:build": "node scripts/build-x-image-map.mjs --write --emit-source",
    "x-bey-primary-images:build": "python scripts/process-x-images.py --report data/source/x-bey-primary-images.json --output-root . --source-cache .cache/x-alpha-sources",
    "x-bey-front-sizes:build": "python scripts/normalize-x-bey-front-images.py --write",
    "x-part-previews:build": "node scripts/build-x-part-preview-map.mjs --write",
    "x-part-previews:emit": "node scripts/build-x-part-preview-map.mjs --emit-source",
    "x-part-previews:hash-review": "node scripts/record-x-part-preview-output-hashes.mjs",
    "x-part-previews:audit": "python scripts/audit-x-part-preview-similarity.py",
    "x-part-previews:review:report": "node scripts/build-x-part-preview-review-report.mjs",
    "x-material-part-previews:build": "python scripts/build-x-material-part-previews.py",
    "x-material-part-previews:apply": "node scripts/apply-x-material-part-preview-derivations.mjs",
    "test:x-material-part-previews": "node scripts/validate-x-material-part-previews.mjs",
    "test:x-images": "node scripts/validate-x-images.mjs && node --test tests/x-october-images.test.mjs",
    "test:x-bey-primary-images": "node scripts/validate-x-bey-primary-images.mjs",
    "test:x-part-previews": "node scripts/validate-x-part-previews.mjs",
    "test:data": "node scripts/validate-data.mjs",
    "test:smoke": "node scripts/run-browser-tests.mjs all",
    "check": "node scripts/run-checks.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:contracts": "node --test tests/validation-contracts.test.mjs tests/generated-data.test.mjs tests/app-audit.test.mjs tests/check-runner.test.mjs tests/resource-observer.test.mjs",
    "test:behavior": "node scripts/run-browser-tests.mjs behavior",
    "test:visual": "node scripts/run-browser-tests.mjs visual",
    "test:resources": "node scripts/run-browser-tests.mjs resources",
    "check:structure": "node scripts/run-checks.mjs --group=structure",
    "check:data": "node scripts/run-checks.mjs --group=data",
    "check:behavior": "node scripts/run-checks.mjs --group=behavior",
    "check:visual": "node scripts/run-checks.mjs --group=visual",
    "check:resources": "node scripts/run-checks.mjs --group=resources"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.31.0"
  }
}
